# Copy this file to .env and fill in your own values. Never commit the real .env file.

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=olist_user
POSTGRES_PASSWORD=olist_pass
POSTGRES_DB=olist_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Kaggle API (for dataset download) ────────────────
# Get these from kaggle.com -> Account -> Create New API Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# -- Task 3 inference service --------------------------------------
API_PORT=8000
MODEL_VERSION=task-2-random-forest
PREDICTION_THRESHOLD=0.5
MAX_BATCH_SIZE=1000
LOG_LEVEL=INFO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_PORT=5000
MODEL_SOURCE=artifact_store
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_MODEL_NAME=olist-late-delivery
MLFLOW_MODEL_STAGE=Production
