# Copy this file to .env and fill in your own values. Never commit the real .env file.

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=olist_user
POSTGRES_PASSWORD=olist_pass
POSTGRES_DB=olist_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Kaggle API (for dataset download) ────────────────
# Get these from kaggle.com -> Account -> Create New API Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key
